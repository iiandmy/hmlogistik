FROM node:22-alpine
WORKDIR /app

# Copy only what Prisma needs: schema, migrations, and config
COPY packages/database/prisma ./packages/database/prisma
COPY packages/database/package.json packages/database/tsconfig.json packages/database/prisma.config.ts ./packages/database/

# Install only Prisma CLI (no full workspace install)
RUN npm install -g prisma@^7.9.0

CMD ["prisma", "migrate", "deploy", "--schema=packages/database/prisma/schema.prisma"]