# Minimal image for running Prisma migrations
FROM node:22-alpine
WORKDIR /app

# Copy Prisma schema, migrations, and config
COPY packages/database/prisma ./packages/database/prisma
COPY packages/database/prisma.config.ts ./packages/database/

# Install Prisma CLI globally
RUN npm install -g prisma@^7.9.0

# DATABASE_URL is provided via docker-compose environment.
# prisma.config.ts uses env('DATABASE_URL') which reads from .env,
# so we create .env from the environment variable at runtime.
CMD sh -c 'cd packages/database \
  && echo "DATABASE_URL=$DATABASE_URL" > .env \
  && npx prisma migrate deploy'
