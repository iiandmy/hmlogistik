# ── HM Logistik — Production Caddy Configuration ───────────────────────────
# Caddy automatically provisions and renews Let's Encrypt SSL certificates.
# Replace ${DOMAIN} with your actual domain (e.g., hmlogistik.com).
#
# Environment variable interpolation is supported when using:
#   docker compose ... up
# because Compose passes the host environment into the Caddy container.

${DOMAIN} {
    # ── API reverse proxy ───────────────────────────────────────────────────
    # Strip the /api prefix and forward to the NestJS backend
    handle_path /api/* {
        reverse_proxy api:3000
    }

    # ── Static SPA ──────────────────────────────────────────────────────────
    # Serve the built frontend (nginx:alpine inside the web container)
    handle {
        reverse_proxy web:80
    }

    # ── Logs ────────────────────────────────────────────────────────────────
    log {
        output file /data/access.log
    }
}