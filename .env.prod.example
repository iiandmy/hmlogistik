# Production environment for docker-compose.prod.yml
# Copy to .env on the server and replace every placeholder.

DOMAIN=app.example.com
FILES_DOMAIN=files.example.com

POSTGRES_USER=hmlogistik
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=hmlogistik
DATABASE_URL=postgresql://hmlogistik:replace-with-strong-password@postgres:5432/hmlogistik

MINIO_ROOT_USER=hmlogistik-minio
MINIO_ROOT_PASSWORD=replace-with-another-strong-password
MINIO_BUCKET=hmlogistik-files
MINIO_PUBLIC_URL=https://files.example.com

CORS_ORIGIN=https://app.example.com
