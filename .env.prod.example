# =============================================================================
# HM Logistik — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before deploying.
#   cp .env.prod.example .env
#
# IMPORTANT: Generate strong random passwords for secrets:
#   openssl rand -base64 32
# =============================================================================

# ── Domain ──────────────────────────────────────────────────────────────────
# The domain name where the app will be accessible (e.g., hmlogistik.com).
DOMAIN=your-domain.com

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=hmlogistik
POSTGRES_PASSWORD=admin_pwd
POSTGRES_DB=hmlogistik

# Full connection string used by Prisma and the API.
# The hostname must match the Docker Compose service name: postgres
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ── MinIO (S3-compatible object storage) ───────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=hmlogistik-files