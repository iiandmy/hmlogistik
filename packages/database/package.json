{
    "name": "@hmlogistik/database",
    "type": "module",
    "version": "1.0.0",
    "private": true,
    "exports": {
        ".": {
            "types": "./index.ts",
            "default": "./dist/index.js"
        },
        "./*": "./*"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "dotenv -e ../../.env -- prisma generate && tsc",
        "db:generate": "dotenv -e ../../.env -- prisma generate",
        "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
        "db:push": "dotenv -e ../../.env -- prisma db push",
        "lint": "eslint ."
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.0"
    },
    "devDependencies": {
        "@hmlogistik/eslint-config": "*",
        "@types/node": "^26.1.2",
        "prisma": "^7.9.0"
    }
}
